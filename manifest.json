{
  "$schema": "https://stina.app/schemas/extension-manifest.json",
  "id": "ollama-provider",
  "name": "Ollama AI Provider",
  "version": "1.0.13",
  "description": "Connect Stina to your local Ollama instance for private, offline AI conversations.",
  "type": "provider",
  "author": {
    "name": "Stina Team",
    "url": "https://github.com/einord"
  },
  "repository": "https://github.com/einord/stina-ext-ollama",
  "license": "MIT",
  "engines": {
    "stina": ">=0.5.0"
  },
  "platforms": ["web", "electron", "tui"],
  "main": "index.js",

  "permissions": [
    "network:*",
    "provider.register"
  ],

  "contributes": {
    "providers": [
      {
        "id": "ollama",
        "name": "Ollama",
        "description": "Local AI models via Ollama",
        "suggestedDefaultModel": "llama3.2:8b",
        "defaultSettings": {
          "url": "http://localhost:11434",
          "thinking": "off"
        },
        "configView": {
          "content": {
            "component": "VerticalStack",
            "gap": 1,
            "children": [
              {
                "component": "TextInput",
                "label": "Server URL",
                "placeholder": "http://localhost:11434",
                "value": "$settings.url"
              },
              {
                "component": "Select",
                "label": "Thinking Mode",
                "selectedValue": "$settings.thinking",
                "options": [
                  { "value": "off", "label": "Off" },
                  { "value": "on", "label": "On" },
                  { "value": "low", "label": "Low (extended)" },
                  { "value": "medium", "label": "Medium (extended)" },
                  { "value": "high", "label": "High (extended)" }
                ]
              }
            ]
          }
        }
      }
    ]
  }
}
